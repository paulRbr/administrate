<% if existing_action?(collection_presenter.resource_name, :edit, page.try(:resource)&.class) %>
  <td class="cell-label--action-button"><%= link_to(
    t("administrate.actions.edit"),
    [:edit, namespace, page.try(:resource), resource].compact,
    class: "action-edit",
  ) if accessible_action?(resource, :edit, page.try(:resource)) %></td>
<% elsif existing_action?(collection_presenter.resource_name, :edit) %>
  <td class="cell-label--action-button"><%= link_to(
    t("administrate.actions.edit"),
    [:edit, namespace, resource],
    class: "action-edit",
  ) if accessible_action?(resource, :edit) %></td>
<% end %>

<% if existing_action?(collection_presenter.resource_name, :destroy, page.try(:resource)&.class) %>
  <td class="cell-label--action-button"><%= button_to(
    t("administrate.actions.destroy"),
    [namespace, page.try(:resource), resource],
    class: "link link--danger",
    method: :delete,
    data: { turbo_confirm: t("administrate.actions.confirm") }
  ) if accessible_action?(resource, :destroy, page.try(:resource)) %></td>
<% elsif existing_action?(collection_presenter.resource_name, :destroy) %>
  <td class="cell-label--action-button"><%= button_to(
    t("administrate.actions.destroy"),
    [namespace, resource],
    class: "link link--danger",
    method: :delete,
    data: { turbo_confirm: t("administrate.actions.confirm") }
  ) if accessible_action?(resource, :destroy) %></td>
<% end %>
